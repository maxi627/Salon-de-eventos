# Copiar a App/.env y completar. Nunca subir App/.env al repositorio.

# --- Flask ---
FLASK_ENV=production                     # development | production
FRONTEND_URL=https://saloneventos.cloud  # base de los enlaces de los correos (reseteo de contraseña)

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DEV_DB=
POSTGRES_PROD_DB=
DEV_DATABASE_URI=postgresql://usuario:clave@db:5432/base_dev
PROD_DATABASE_URI=postgresql://usuario:clave@db:5432/base_prod

# --- Redis (caché, límites de pedidos y cola de Celery) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:clave@redis:6379/0
CELERY_RESULT_BACKEND=redis://:clave@redis:6379/0

# --- Autenticación ---
JWT_SECRET_KEY=                          # obligatoria en producción, 32 caracteres o más
PASSWORD_RESET_SECRET=                   # opcional; si falta se deriva de JWT_SECRET_KEY
MASTER_DELETE_PASSWORD=                  # contraseña extra para borrar pagos desde el panel

# --- Cloudflare ---
TURNSTILE_SECRET_KEY=                    # obligatoria en producción (la site key va en el frontend)
CF_DNS_API_TOKEN=                        # token con permiso Zone:DNS:Edit; Traefik lo usa para los certificados
CLOUDFLARE_ORIGIN_LOCK=,cloudflare-only@file   # vacío = el servidor acepta tráfico que no pase por Cloudflare
TRUST_CLOUDFLARE_IP_HEADER=true          # tomar la IP del cliente de CF-Connecting-IP (solo detrás de Cloudflare)

# --- Cloudflare R2 (comprobantes de pago) ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Datos de pago que ve el cliente ---
PAYMENT_ALIAS=

# --- Correo (SMTP) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_APP_PASSWORD=                     # contraseña de aplicación de Gmail, no la de la cuenta
ADMIN_EMAIL=                             # recibe copia de los correos que se envían a los clientes

# --- Telegram (avisos a la administración) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=                       # separados por coma

# --- Sentry ---
SENTRY_DSN_BACKEND=

# --- Asistente del chat (Claude) ---
ANTHROPIC_API_KEY=                       # sin esta clave el chat deriva a WhatsApp
CHATBOT_MODEL=                           # opcional; por defecto claude-haiku-5-5

# --- Backups (opt/backup.sh) ---
PASSWORD_CIFRADO=                        # clave AES-256 de los backups; guardarla fuera del servidor
RCLONE_DESTINO=gdrive:Backups_Salon/
